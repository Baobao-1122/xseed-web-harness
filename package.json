{
  "name": "@xseed/web-harness",
  "version": "0.2.0",
  "description": "可复用的 Web 项目测试 harness：分层编排 Vitest / Shell / 环境矩阵，统一质量门禁",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "harness": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "pnpm build",
    "prepack": "pnpm test && pnpm build",
    "pack:check": "pnpm pack --pack-destination ./.pack && tar -tzf ./.pack/xseed-web-harness-*.tgz"
  },
  "keywords": [
    "test-harness",
    "vitest",
    "quality-gate",
    "web"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baobao-1122/xseed-web-harness.git"
  },
  "homepage": "https://github.com/Baobao-1122/xseed-web-harness#readme",
  "bugs": {
    "url": "https://github.com/Baobao-1122/xseed-web-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "jiti": "^2.4.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  }
}
